# ==============================================================================
# CodeAlpha Language Translation Tool - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and modify the values as needed.
# NEVER commit your actual '.env' file containing secrets to version control.
# ==============================================================================

# Primary Translation Provider: 'libretranslate' or 'mymemory'
TRANSLATION_PROVIDER=libretranslate

# LibreTranslate Endpoint URL
# Official hosted instance (requires API key): https://libretranslate.com
# Local self-hosted instance (free, no key required): http://localhost:5000
LIBRETRANSLATE_API_URL=https://libretranslate.com

# LibreTranslate API Key
# Leave empty if running a local instance or using a free mirror without auth.
# Get a key from: https://portal.libretranslate.com
LIBRETRANSLATE_API_KEY=

# Fallback / Alternative Provider Configuration (MyMemory)
# MyMemory is free up to 50,000 characters/day without an email,
# or up to 500,000 characters/day if an email is provided.
MYMEMORY_API_URL=https://api.mymemory.translated.net/get
MYMEMORY_USER_EMAIL=

# HTTP Request Timeout in seconds
REQUEST_TIMEOUT=10
